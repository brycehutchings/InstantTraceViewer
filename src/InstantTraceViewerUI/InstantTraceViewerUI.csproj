<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>InstantTraceViewerUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <StartupObject>InstantTraceViewerUI.Program</StartupObject>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Nullable>annotations</Nullable>
    <ApplicationIcon>Assets\Logo.ico</ApplicationIcon>

    <!-- AOT compilation may improve startup times -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <PublishTrimmed>true</PublishTrimmed>

    <PublishSelfContained>true</PublishSelfContained>

    <!-- Single file has slower startup on first run (Defender scan?)-->
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\DroidSans-Bold.ttf" />
    <None Remove="Assets\DroidSans.ttf" />
    <None Remove="Assets\Fonts\CascadiaMono.ttf" />
    <None Remove="Assets\Fonts\Font Awesome 6 Free-Solid-900.otf" />
    <None Remove="FieldMap_HResults.tsv" />
    <None Remove="FieldMap_NTStatus.tsv" />
    <None Remove="FieldMap_Win32Errors.tsv" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="FieldMap_HResults.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="FieldMap_NTStatus.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="FieldMap_Win32Errors.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.0-rc1" />
    <PackageReference Include="Google.Protobuf.Tools" Version="3.34.1" />
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
    <PackageReference Include="Hexa.NET.ImGui.Backends" Version="1.0.18" />
    <PackageReference Include="Microsoft.Debugging.Platform.DbgEng" Version="20260319.1511.0" />
    <PackageReference Include="Microsoft.Debugging.Platform.SymSrv" Version="20260319.1511.0" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.275">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.4" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1721" />
    <PackageReference Include="System.IO.Hashing" Version="11.0.0-preview.3.26207.106" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="NativeMethods.txt" />
  </ItemGroup>

  <!-- Static items (not a copy target) so the app-local dbghelp/symsrv also flow into publish and MSIX output. -->
  <ItemGroup Condition="'$(PlatformTarget)' == 'x64'">
    <DebuggingPlatformDll Include="$(MicrosoftDebuggingPlatformDbgEngContent)amd64\dbgcore.dll" />
    <DebuggingPlatformDll Include="$(MicrosoftDebuggingPlatformDbgEngContent)amd64\dbghelp.dll" />
    <DebuggingPlatformDll Include="$(MicrosoftDebuggingPlatformSymSrvContent)amd64\symsrv.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(PlatformTarget)' == 'arm64'">
    <DebuggingPlatformDll Include="$(MicrosoftDebuggingPlatformDbgEngContent)arm64\dbgcore.dll" />
    <DebuggingPlatformDll Include="$(MicrosoftDebuggingPlatformDbgEngContent)arm64\dbghelp.dll" />
    <DebuggingPlatformDll Include="$(MicrosoftDebuggingPlatformSymSrvContent)arm64\symsrv.dll" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="@(DebuggingPlatformDll)" Visible="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ValidateDebuggingPlatformDlls" BeforeTargets="Build">
    <Error Condition="'@(DebuggingPlatformDll)' == ''" Text="No Debugging Platform DLLs for PlatformTarget='$(PlatformTarget)'." />
    <Error Condition="!Exists('%(DebuggingPlatformDll.FullPath)')" Text="Unable to find '%(DebuggingPlatformDll.FullPath)'." />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\CascadiaMono.ttf">
      <LogicalName>CascadiaMono.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\Fonts\DroidSans.ttf">
      <LogicalName>DroidSans.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\Fonts\Font Awesome 6 Free-Solid-900.otf">
      <LogicalName>Font Awesome 6 Free-Solid-900.otf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
